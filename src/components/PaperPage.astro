---
// The paper page in one language: the first screen (title block, finding,
// "At a glance", page navigation) and the sections. Every language page
// renders this with its own copy, so the pages share their structure, anchors
// and layout and differ only in words.
import type { PageCopy } from '../content/types'
import Page from '../layouts/Page.astro'
import Finding from './Finding.astro'
import Glance from './Glance.astro'
import PageNav from './PageNav.astro'
import Sections from './Sections.astro'
import TitleBlock from './TitleBlock.astro'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
---

<Page copy={copy}>
  <div class="front page-width">
    <div class="lead">
      <TitleBlock copy={copy} />
      <Finding copy={copy} />
    </div>
    <div class="margin">
      <Glance copy={copy} />
    </div>
    <div class="nav">
      <PageNav copy={copy} />
    </div>
  </div>
  <div class="body page-width">
    <div class="column">
      <Sections copy={copy} />
    </div>
  </div>
</Page>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'lead'
      'margin'
      'nav';
    row-gap: 2rem;
    padding-top: 2.5rem;
  }

  .lead {
    grid-area: lead;
    display: grid;
    gap: 1.5rem;
  }

  .margin {
    grid-area: margin;
  }

  .nav {
    grid-area: nav;
  }

  .column {
    max-width: var(--column);
  }

  /* Figures and tables too wide for the reading column (.span-margin) reach
     into the page margin on wide screens: they span the content box of the
     body, which is column, gap and margin at full width and narrower between
     68rem and about 73rem, where the gutters leave less room. The body is the
     query container that 100cqi measures. On narrower screens wide tables
     scroll instead. */
  .body {
    container-type: inline-size;
  }

  @media (min-width: 68rem) {
    .body :global(.span-margin) {
      width: 100cqi;
    }
  }

  @media (min-width: 68rem) {
    .front {
      grid-template-columns: minmax(0, var(--column)) var(--margin-column);
      grid-template-areas:
        'lead margin'
        'nav margin';
      column-gap: var(--column-gap);
      align-items: start;
    }

    .margin {
      border-left: 1px solid var(--rule);
      padding-left: 1.75rem;
      margin-top: 0.4rem;
    }
  }
</style>
