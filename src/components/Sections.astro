---
import type { PageCopy } from '../content/types'
import Bibtex from './Bibtex.astro'
import Figure from './Figure.astro'
import Inline from './Inline.astro'
import PaperTable from './PaperTable.astro'
import SourceLinks from './SourceLinks.astro'
import { numberQuestions } from '../lib/sections'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props

// Question sections are numbered in reading order; the numbers carry the
// argument's sequence, and the page navigation repeats them.
const sections = numberQuestions(copy.sections)
---

{
  sections.map(({ section, number }) => (
    <section id={section.id} class:list={['section', `section-${section.kind}`]} aria-labelledby={`${section.id}-heading`}>
      <h2 id={`${section.id}-heading`}>
        {number !== null && (
          <span class="numeral" aria-hidden="true">
            {number}
          </span>
        )}
        <span class="heading-text">
          <Inline text={section.heading} lang={copy.lang} />
        </span>
      </h2>
      {section.kind === 'question' && (
        <p class="answer" data-answer>
          <Inline text={section.answer} lang={copy.lang} />
        </p>
      )}
      {section.blocks.map((block) => {
        switch (block.type) {
          case 'abstract':
            return (
              <p>
                <Inline text={copy.abstract} lang={copy.lang} />
              </p>
            )
          case 'paragraph':
            return (
              <p>
                <Inline text={block.text} lang={copy.lang} />
                <SourceLinks copy={copy} sources={block.sources} />
              </p>
            )
          case 'subheading':
            return (
              <h3 id={`${section.id}-${block.id}`}>
                <Inline text={block.text} lang={copy.lang} />
              </h3>
            )
          case 'figure':
            return <Figure copy={copy} figure={block.figure} />
          case 'table':
            return <PaperTable copy={copy} table={block.table} />
          case 'bibtex':
            return <Bibtex copy={copy} />
        }
      })}
    </section>
  ))
}

<style>
  .section {
    margin-top: 3.5rem;
    scroll-margin-top: 1.5rem;
  }

  h2 {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 1.4375rem;
    font-weight: 650;
    letter-spacing: -0.005em;
  }

  h2 .numeral {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 4px;
    font-size: 0.875rem;
    transform: translateY(-0.12em);
  }

  h3 {
    margin-top: 2.25rem;
    font-size: 1.125rem;
    font-weight: 650;
    scroll-margin-top: 1.5rem;
  }

  p {
    max-width: var(--measure);
    margin-top: 0.9rem;
  }

  .answer {
    margin-top: 1rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }
</style>
