---
import type { PageCopy } from '../content/types'
import { authorName, icpNumber, links, maintainer } from '../data/paper'
import { punctuationFor } from '../lib/format'
import { copyrightLine } from '../lib/footer'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
const marks = punctuationFor(copy.lang)
const maintainerName = authorName(maintainer, copy.lang)
---

<footer class="site-footer">
  <div class="inner page-width">
    <p>{copyrightLine(copy)}</p>
    <p>
      {copy.footer.maintainedBy}{marks.join}{
        maintainer.homepage === null ? maintainerName : <a href={maintainer.homepage}>{maintainerName}</a>
      }{marks.fullStop}
    </p>
    <p><a href={links.icpRegistry} rel="nofollow" lang="zh-Hans">{icpNumber}</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
  }

  .inner {
    padding-block: 1.5rem 2.5rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  a {
    color: var(--ink-muted);
  }
</style>
