---
import type { PageCopy } from '../content/types'
import { affiliationIds, affiliationMarks, affiliationName, authorName, authors, correspondingMark, links } from '../data/paper'
import { punctuationFor } from '../lib/format'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
const marks = punctuationFor(copy.lang)
---

<header class="title-block">
  <h1>{copy.title}</h1>
  <p class="authors">
    {
      authors.map((author, index) => (
        <span class="author" data-author>
          {author.homepage === null ? (
            <span data-author-name>{authorName(author, copy.lang)}</span>
          ) : (
            <a href={author.homepage} data-author-name>
              {authorName(author, copy.lang)}
            </a>
          )}
          <sup data-author-affiliations>{affiliationMarks(author)}</sup>
          {author.corresponding && (
            <sup class="corresponding" data-author-corresponding>
              <abbr title={copy.correspondingNote}>{correspondingMark}</abbr>
            </sup>
          )}
          {index < authors.length - 1 && <span class="separator">{marks.authorSeparator}</span>}
        </span>
      ))
    }
  </p>
  <ul class="affiliations">
    {
      affiliationIds.map((id) => (
        <li data-affiliation>
          <sup>{id}</sup> {affiliationName(id, copy.lang)}
        </li>
      ))
    }
  </ul>
  <p class="corresponding-note"><sup>{correspondingMark}</sup> {copy.correspondingNote}</p>
  <ul class="links" data-links>
    <li><a href={links.arxivAbs}>{copy.links.arxiv}</a></li>
    <li><a href={links.pdf}>{copy.links.pdf}</a></li>
    <li><a href={links.explorer} hreflang="zh-Hans">{copy.links.explorer}</a></li>
    <li><a href="#cite">{copy.links.cite}</a></li>
  </ul>
</header>

<style>
  h1 {
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.3rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .authors {
    margin-top: 1.1rem;
    font-size: 1.0625rem;
  }

  .authors a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .authors a:hover {
    text-decoration-color: currentColor;
  }

  sup {
    font-size: 0.68em;
    line-height: 0;
    color: var(--ink-muted);
    margin-left: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .corresponding abbr {
    text-decoration: none;
    cursor: help;
  }

  .affiliations {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .affiliations sup {
    margin: 0 0.1em 0 0;
  }

  .corresponding-note {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .corresponding-note sup {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    transition: border-color 120ms ease-out, background-color 120ms ease-out;
  }

  .links a:hover {
    border-color: var(--indigo);
    background: var(--indigo-wash);
  }
</style>
