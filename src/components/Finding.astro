---
import type { PageCopy } from '../content/types'
import Inline from './Inline.astro'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
---

<p class="finding" data-finding><Inline text={copy.finding} lang={copy.lang} /></p>

<style>
  .finding {
    max-width: var(--measure);
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  :global(html:lang(zh)) .finding {
    line-height: 1.75;
  }
</style>
