---
import type { InlineMarkdown, PageCopy } from '../content/types'
import { pdfPageUrl } from '../data/paper'
import { tableLayouts, tablePages, type TableId } from '../data/tables'
import Inline from './Inline.astro'

interface Props {
  readonly copy: PageCopy
  readonly table: TableId
  readonly label: string
  readonly caption: InlineMarkdown
}

const { copy, table, label, caption } = Astro.props
const layout = tableLayouts[table]
const captionId = `table-${table}-caption`
const page = tablePages[table]

// The caption sits outside the scrolling region so it never scrolls away; the
// region is focusable and named after the table so keyboard users can scroll
// a wide table on a narrow screen.
---

<figure class:list={['table-figure', `table-${layout}`]} id={`table-${table}`} data-table={table}>
  <figcaption id={captionId}>
    <span class="label">{label}.</span>{' '}
    <Inline text={caption} lang={copy.lang} />{' '}
    <a class="page-link" href={pdfPageUrl(page)}>{copy.sources.pages([page])}</a>
  </figcaption>
  <div class="scroll" role="region" tabindex="0" aria-label={copy.tables.scrollRegion(label)}>
    <table aria-describedby={captionId}>
      <slot />
    </table>
  </div>
</figure>

<style>
  .table-figure {
    margin: 2rem 0 0;
  }

  /* A table too wide for the reading column uses the page margin on wide
     screens, as the framework figure does; on narrower screens it scrolls. */
  @media (min-width: 68rem) {
    .table-wide {
      width: calc(var(--column) + var(--column-gap) + var(--margin-column));
    }
  }

  figcaption {
    max-width: var(--measure);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .label {
    font-weight: 650;
    color: var(--ink);
  }

  .page-link {
    white-space: nowrap;
    color: var(--ink-muted);
    text-decoration-color: var(--rule);
  }

  .page-link:hover {
    color: var(--indigo);
    text-decoration-color: currentColor;
  }

  .scroll {
    margin-top: 0.75rem;
    overflow-x: auto;
    scrollbar-color: var(--rule) transparent;
  }

  table {
    border-collapse: collapse;
    min-width: 100%;
    font-size: 0.875rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums lining-nums;
  }

  table :global(caption) {
    display: none;
  }

  table :global(th),
  table :global(td) {
    padding: 0.45rem 0.75rem;
    text-align: right;
    white-space: nowrap;
    border-bottom: 1px solid var(--rule);
  }

  table :global(th:first-child),
  table :global(td:first-child) {
    padding-left: 0;
    text-align: left;
  }

  table :global(thead th) {
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1.5px solid var(--ink-muted);
    vertical-align: bottom;
  }

  table :global(tbody tr:last-child > *) {
    border-bottom: 1.5px solid var(--ink-muted);
  }

  table :global(tfoot td) {
    font-weight: 600;
    border-bottom: none;
  }

  table :global(.wrap) {
    white-space: normal;
    min-width: 14rem;
  }
</style>
