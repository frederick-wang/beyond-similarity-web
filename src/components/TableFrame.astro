---
import type { InlineMarkdown, PageCopy } from '../content/types'
import { tableLayouts, tablePages, type TableId } from '../data/tables'
import { punctuationFor } from '../lib/format'
import { pageLink } from '../lib/sources'
import Inline from './Inline.astro'

interface Props {
  readonly copy: PageCopy
  readonly table: TableId
  readonly label: string
  readonly caption: InlineMarkdown
}

const { copy, table, label, caption } = Astro.props
const layout = tableLayouts[table]
const captionId = `table-${table}-caption`
const pdf = pageLink(copy, tablePages[table])
const marks = punctuationFor(copy.lang)

// The caption sits outside the scrolling region so it never scrolls away; the
// region is focusable and named after the table so keyboard users can scroll
// a wide table on a narrow screen.
---

<figure class:list={['table-figure', { 'span-margin': layout === 'wide' }]} id={`table-${table}`} data-table={table}>
  <figcaption class="caption" id={captionId}>
    <span class="label">{label}{marks.labelEnd}</span>{' '}
    <Inline text={caption} lang={copy.lang} />{marks.join}<a class="quiet-link page-link" href={pdf.href}>{pdf.label}</a>
  </figcaption>
  <div class="scroll" role="region" tabindex="0" aria-label={copy.tables.scrollRegion(label)}>
    <table aria-describedby={captionId}>
      <slot />
    </table>
  </div>
</figure>

<style>
  .table-figure {
    margin: 2rem 0 0;
  }

  .page-link {
    white-space: nowrap;
  }

  .scroll {
    margin-top: 0.75rem;
    overflow-x: auto;
    scrollbar-color: var(--rule) transparent;
  }

  table {
    border-collapse: collapse;
    min-width: 100%;
    font-size: 0.875rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums lining-nums;
  }

  table :global(th),
  table :global(td) {
    padding: 0.45rem 0.75rem;
    text-align: right;
    white-space: nowrap;
    border-bottom: 1px solid var(--rule);
  }

  table :global(th:first-child),
  table :global(td:first-child) {
    padding-left: 0;
    text-align: left;
  }

  table :global(thead th) {
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1.5px solid var(--ink-muted);
    vertical-align: bottom;
  }

  table :global(tbody tr:last-child > *) {
    border-bottom: 1.5px solid var(--ink-muted);
  }

  table :global(tfoot td) {
    font-weight: 600;
    border-bottom: none;
  }

  table :global(.wrap) {
    white-space: normal;
    min-width: 14rem;
  }
</style>
