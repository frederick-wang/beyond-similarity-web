---
import type { Section } from '../content/types'

interface Props {
  readonly sections: readonly Section[]
}

const { sections } = Astro.props
---

<ol>
  {
    sections.map((section) => (
      <li>
        <a href={`#${section.id}`}>{section.heading}</a>
      </li>
    ))
  }
</ol>

<style>
  ol {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
