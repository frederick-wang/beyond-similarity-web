---
import type { PageCopy } from '../content/types'
import { stats } from '../data/paper'
import { modelRows, modelTotals } from '../data/tables'
import { formatCount, formatDecimal, formatPercent } from '../lib/format'
import TableFrame from './TableFrame.astro'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
const text = copy.tables.models
---

<TableFrame copy={copy} table="models" label={text.label} caption={text.caption}>
  <thead>
    <tr>
      <th scope="col">{text.headers.model}</th>
      <th scope="col">{text.headers.candidates}</th>
      <th scope="col">{text.headers.valid}</th>
      <th scope="col">{text.headers.precision}</th>
      <th scope="col">{text.headers.cost}</th>
      <th scope="col">{text.headers.costPerValid}</th>
      <th scope="col">{text.headers.latency}</th>
    </tr>
  </thead>
  <tbody>
    {
      modelRows.map((row) => (
        <tr data-model={row.model} class:list={{ deployment: row.model === stats.deploymentModel }}>
          <th scope="row">
            <code>{row.model}</code>
          </th>
          <td>{formatCount(row.candidates)}</td>
          <td>{formatCount(row.valid)}</td>
          <td>{formatPercent(row.precision)}</td>
          <td>{formatCount(row.cost)}</td>
          <td>{formatDecimal(row.costPerValid, 3)}</td>
          <td>{formatCount(row.latency)}</td>
        </tr>
      ))
    }
  </tbody>
  <tfoot>
    <tr data-total>
      <td>{text.total}</td>
      <td>{formatCount(modelTotals.candidates)}</td>
      <td>{formatCount(modelTotals.valid)}</td>
      <td></td>
      <td>{formatCount(modelTotals.cost)}</td>
      <td></td>
      <td></td>
    </tr>
  </tfoot>
</TableFrame>

<style>
  th[scope='row'] {
    font-weight: 400;
  }

  /* The deployment model is the one the corpus run uses; an indigo wash marks
     its row, the color that marks the reader's position elsewhere. */
  tr.deployment th,
  tr.deployment td {
    background: var(--indigo-wash);
  }
</style>
