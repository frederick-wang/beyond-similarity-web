---
import type { PageCopy } from '../content/types'
import { bibtex } from '../data/paper'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
const entry = bibtex()
---

<div class="bibtex" data-copy-done={copy.copyButton.done} data-copy-failed={copy.copyButton.failed}>
  <div class="entry" role="region" aria-label={copy.bibtexLabel} tabindex="0">
    <pre><code>{entry}</code></pre>
  </div>
  <div class="actions">
    <button type="button" hidden data-copy-button>{copy.copyButton.idle}</button>
    <span class="status" role="status" aria-live="polite" data-copy-status></span>
  </div>
</div>

<script>
  // Progressive enhancement: the button stays hidden until the Clipboard API
  // is available, so a page without scripts shows no control that cannot work.
  for (const root of document.querySelectorAll<HTMLElement>('.bibtex')) {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-button]')
    const status = root.querySelector<HTMLElement>('[data-copy-status]')
    const code = root.querySelector('pre')
    if (button === null || status === null || code === null) {
      throw new Error('BibTeX component markup is incomplete')
    }
    if (navigator.clipboard === undefined) {
      continue
    }
    const done = root.dataset['copyDone']
    const failed = root.dataset['copyFailed']
    if (done === undefined || failed === undefined) {
      throw new Error('BibTeX copy labels are missing from the component markup')
    }
    button.hidden = false
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(code.innerText).then(
        () => {
          status.textContent = done
        },
        () => {
          status.textContent = failed
        },
      )
    })
  }
</script>

<style>
  .bibtex {
    margin-top: 1rem;
  }

  .entry {
    overflow-x: auto;
    background: var(--wash);
    border: 1px solid var(--rule);
    border-radius: 8px;
    scrollbar-color: var(--rule) transparent;
  }

  pre {
    margin: 0;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.75rem;
    min-height: 2.25rem;
  }

  button {
    min-height: 2.25rem;
    padding: 0 0.95rem;
    border: 1px solid var(--indigo);
    border-radius: 6px;
    background: var(--paper);
    color: var(--indigo);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 550;
    cursor: pointer;
    transition: background-color 120ms ease-out;
  }

  button:hover {
    background: var(--indigo-wash);
  }

  button:active {
    transform: translateY(1px);
  }

  .status {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
</style>
