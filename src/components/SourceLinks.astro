---
import type { PageCopy, SourceRef } from '../content/types'
import { pdfPageUrl } from '../data/paper'
import { punctuationFor } from '../lib/format'

interface Props {
  readonly copy: PageCopy
  readonly sources: readonly SourceRef[]
}

const { copy, sources } = Astro.props
const marks = punctuationFor(copy.lang)
---

{
  sources.length > 0 && (
    <>
    {marks.join}
    <span class="sources" data-sources>
      {copy.sources.lead}{marks.join}{sources.map((source, index) => (
        <>
          {index > 0 && marks.sourceSeparator}
          <a class="quiet-link" href={pdfPageUrl(source.pages[0])}>
            {copy.sources.parts[source.part]} · {copy.sources.pages(source.pages)}
          </a>
        </>
      ))}
    </span>
    </>
  )
}

<style>
  .sources {
    display: inline-block;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
