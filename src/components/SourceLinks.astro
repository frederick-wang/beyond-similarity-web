---
import type { PageCopy, SourceRef } from '../content/types'
import { punctuationFor } from '../lib/format'
import { sourceLink } from '../lib/sources'

interface Props {
  readonly copy: PageCopy
  readonly sources: readonly SourceRef[]
}

const { copy, sources } = Astro.props
const marks = punctuationFor(copy.lang)
const links = sources.map((source) => sourceLink(copy, source))
---

{
  links.length > 0 && (
    <>
    {marks.join}
    <span class="sources" data-sources>
      {copy.sources.lead}{marks.join}{links.map((link, index) => (
        <>
          {index > 0 && marks.sourceSeparator}
          <a class="quiet-link" href={link.href}>
            {link.label}
          </a>
        </>
      ))}
    </span>
    </>
  )
}

<style>
  .sources {
    display: inline-block;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
