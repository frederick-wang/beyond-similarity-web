---
import { getImage, Picture } from 'astro:assets'
import type { PageCopy } from '../content/types'
import { figures, type FigureId } from '../data/figures'
import { pdfPageUrl } from '../data/paper'
import Inline from './Inline.astro'

interface Props {
  readonly copy: PageCopy
  readonly figure: FigureId
}

const { copy, figure } = Astro.props
const data = figures[figure]
const text = copy.figures.items[figure]

// Column figures render at most 640 CSS px wide, the wide framework figure at
// the full page width (67.5rem); srcset widths cover 1x and 2x screens.
const layout = {
  column: { widths: [480, 640, 960, 1280], sizes: '(min-width: 48rem) 640px, 100vw' },
  wide: { widths: [720, 1080, 1620, 2160], sizes: '(min-width: 68rem) 1080px, 100vw' },
}[data.layout]

// The full-size link opens the whole source resolution as WebP.
const full = await getImage({ src: data.image, width: data.image.width, format: 'webp' })
---

<figure class:list={['figure', data.layout === 'wide' ? 'span-margin' : 'figure-column']} id={`figure-${figure}`} data-figure={figure}>
  <a class="plate" href={full.src}>
    <Picture
      src={data.image}
      formats={['avif', 'webp']}
      widths={layout.widths}
      sizes={layout.sizes}
      alt={text.alt}
    />
  </a>
  <figcaption class="caption">
    <span class="label">{text.label}.</span>{' '}
    <Inline text={text.caption} lang={copy.lang} />{' '}
    <span class="figure-links">
      <a class="quiet-link" href={full.src}>{copy.figures.openFull}</a>
      <span aria-hidden="true">·</span>
      <a class="quiet-link" href={pdfPageUrl(data.page)}>{copy.sources.pages([data.page])}</a>
    </span>
  </figcaption>
</figure>

<style>
  .figure {
    margin: 2rem 0 0;
  }

  .figure-column {
    max-width: 40rem;
  }

  /* Paper figures are printed on white; the plate keeps them on white in the
     dark theme as well, so their colors and gray bands read as published. */
  .plate {
    display: block;
    padding: 0.75rem;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.75rem;
  }

  .figure-links {
    display: inline-flex;
    gap: 0.4em;
    white-space: nowrap;
  }
</style>
