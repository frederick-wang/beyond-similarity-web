---
import type { PageCopy } from '../content/types'
import { diachronicRows } from '../data/tables'
import { formatDecimal, formatPercent, formatPValue } from '../lib/format'
import TableFrame from './TableFrame.astro'

interface Props {
  readonly copy: PageCopy
}

const { copy } = Astro.props
const text = copy.tables.diachronic
---

<TableFrame copy={copy} table="diachronic" label={text.label} caption={text.caption}>
  <thead>
    <tr>
      <th scope="col">{text.headers.dimension}</th>
      <th scope="col" class="category">{text.headers.dominant}</th>
      <th scope="col">{text.headers.early}</th>
      <th scope="col">{text.headers.late}</th>
      <th scope="col"><i>{text.headers.rho}</i></th>
      <th scope="col"><i>{text.headers.p}</i></th>
    </tr>
  </thead>
  <tbody>
    {
      diachronicRows.map((row) => (
        <tr data-dimension={row.dimension}>
          <th scope="row">{text.dimensions[row.dimension]}</th>
          <td class="category">{text.dominant[row.dominant]}</td>
          <td>{formatPercent(row.early)}</td>
          <td>{formatPercent(row.late)}</td>
          <td>{formatDecimal(row.rho, 2)}</td>
          <td>{formatPValue(row.p)}</td>
        </tr>
      ))
    }
  </tbody>
</TableFrame>

<style>
  th[scope='row'] {
    font-weight: 400;
  }

  .category {
    text-align: left;
  }
</style>
