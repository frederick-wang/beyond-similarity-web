---
import Finding from '../components/Finding.astro'
import Glance from '../components/Glance.astro'
import PageNav from '../components/PageNav.astro'
import Sections from '../components/Sections.astro'
import TitleBlock from '../components/TitleBlock.astro'
import { en } from '../content/en'
import { pages } from '../data/paper'
import Page from '../layouts/Page.astro'
---

<Page copy={en} path={pages.en.path}>
  <div class="front page-width">
    <div class="lead">
      <TitleBlock copy={en} />
      <Finding copy={en} />
    </div>
    <div class="margin">
      <Glance copy={en} />
    </div>
    <div class="nav">
      <PageNav copy={en} />
    </div>
  </div>
  <div class="body page-width">
    <div class="column">
      <Sections copy={en} />
    </div>
  </div>
</Page>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'lead'
      'margin'
      'nav';
    row-gap: 2rem;
    padding-top: 2.5rem;
  }

  .lead {
    grid-area: lead;
    display: grid;
    gap: 1.5rem;
  }

  .margin {
    grid-area: margin;
  }

  .nav {
    grid-area: nav;
  }

  .column {
    max-width: var(--column);
  }

  /* Figures and tables too wide for the reading column (.span-margin) reach
     into the page margin on wide screens: they span the content box of the
     body, which is column, gap and margin at full width and narrower between
     68rem and about 73rem, where the gutters leave less room. The body is the
     query container that 100cqi measures. On narrower screens wide tables
     scroll instead. */
  .body {
    container-type: inline-size;
  }

  @media (min-width: 68rem) {
    .body :global(.span-margin) {
      width: 100cqi;
    }
  }

  @media (min-width: 68rem) {
    .front {
      grid-template-columns: minmax(0, var(--column)) var(--margin-column);
      grid-template-areas:
        'lead margin'
        'nav margin';
      column-gap: var(--column-gap);
      align-items: start;
    }

    .margin {
      border-left: 1px solid var(--rule);
      padding-left: 1.75rem;
      margin-top: 0.4rem;
    }
  }
</style>
